<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_registration_link_form" model="ir.ui.view">
        <field name="name">registration.link.form</field>
        <field name="model">registration.link</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_submissions" type="object" class="oe_stat_button" icon="fa-list-alt" string="View Submissions"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Event Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="slug"/>
                            <field name="active"/>
                            <field name="zoom_link"/>
                            <field name="is_super_admin" invisible="1"/>
                        </group>
                        <group>
                            <field name="access_password" password="True" 
                                   invisible="access_password != False and not is_super_admin"/>
                            <field name="program_image" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Program Details (Success Page)">
                            <field name="program_details"/>
                        </page>
                        <page string="Custom Fields">
                            <field name="field_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="key"/>
                                    <field name="field_type"/>
                                    <field name="required"/>
                                    <field name="selection_options" 
                                           invisible="field_type != 'selection'"
                                           required="field_type == 'selection'"
                                           placeholder="Option1,Option2"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_registration_link_tree" model="ir.ui.view">
        <field name="name">registration.link.tree</field>
        <field name="model">registration.link</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="slug"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_registration_link" model="ir.actions.act_window">
        <field name="name">Registration Links</field>
        <field name="res_model">registration.link</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_registration_portal_root" name="Registration Portal" sequence="10" groups="registration_portal.group_registration_admin"/>
    <menuitem id="menu_registration_link" name="Configuration" parent="menu_registration_portal_root" sequence="10"/>
    <menuitem id="menu_registration_link_action" name="Links" parent="menu_registration_link" action="action_registration_link"/>
</odoo>
