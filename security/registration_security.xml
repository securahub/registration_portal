<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_registration_portal" model="ir.module.category">
        <field name="name">Registration Portal</field>
        <field name="description">Helps you manage your registration links and submissions.</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_registration_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_registration_portal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
