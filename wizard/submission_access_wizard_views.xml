<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_registration_submission_access_wizard" model="ir.ui.view">
        <field name="name">registration.submission.access.wizard.form</field>
        <field name="model">registration.submission.access.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="link_id" invisible="1"/>
                        <field name="password" password="True"/>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Access" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
